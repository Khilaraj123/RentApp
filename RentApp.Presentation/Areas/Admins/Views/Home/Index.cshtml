@{
    ViewData["Title"] = "Admin Console";
}

<div class="dashboard-container">
    <!-- Admin Sidebar ViewComponent -->
    @await Component.InvokeAsync("Sidebar", new { role = "Admin" })

    <!-- Admin Content Area -->
    <main class="dashboard-content">
        <div class="container-fluid p-0">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Platform Administration</h2>
                    <p class="text-muted mb-0">System health, listings verification, and user management.</p>
                </div>
                <div>
                    <span class="badge bg-indigo-subtle text-indigo px-3 py-2 rounded-pill" style="background:#e0e7ff; color:#4338ca;">
                        Admin Privilege Active
                    </span>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3">
                        <span class="text-muted small fw-semibold">TOTAL USERS</span>
                        <h3 class="fw-bold my-1">1,248</h3>
                        <span class="badge bg-success-subtle text-success small">+12% this month</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3">
                        <span class="text-muted small fw-semibold">PENDING LISTINGS</span>
                        <h3 class="fw-bold my-1">12</h3>
                        <span class="badge bg-warning-subtle text-warning-emphasis small">Requires approval</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3">
                        <span class="text-muted small fw-semibold">TRANSACTIONS</span>
                        <h3 class="fw-bold my-1">$142,500</h3>
                        <span class="badge bg-success-subtle text-success small">Processed YTD</span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-3 p-3">
                        <span class="text-muted small fw-semibold">SYSTEM STATUS</span>
                        <h3 class="fw-bold my-1 text-success">Optimal</h3>
                        <span class="badge bg-success-subtle text-success small">100% services online</span>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
