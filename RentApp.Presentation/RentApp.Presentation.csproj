      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RentApp.Application\RentApp.Application.csproj" />
    <ProjectReference Include="..\RentApp.Domain\RentApp.Domain.csproj" />
    <ProjectReference Include="..\RentApp.Infrastructure\RentApp.Infrastructure.csproj" />
    <ProjectReference Include="..\RentApp.Persistence\RentApp.Persistence.csproj" />
  </ItemGroup>

</Project>
