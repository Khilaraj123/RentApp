@model RentApp.Presentation.ViewModels.NavbarViewModel

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentPath = Context.Request.Path.Value ?? "";
}

<nav class="navbar navbar-expand-lg rentapp-navbar sticky-top bg-white border-bottom shadow-sm">
    <div class="container">
        <!-- Brand Logo -->
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary" asp-controller="Home" asp-action="Index">
            <span class="rentapp-logo-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            </span>
            <span class="rentapp-brand-text">RentApp</span>
        </a>

        <!-- Mobile Hamburger Toggler -->
        <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#rentappNavbarContent" aria-controls="rentappNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links & Profile -->
        <div class="collapse navbar-collapse" id="rentappNavbarContent">
            <!-- Center Navigation Links -->
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 gap-lg-2">
                <li class="nav-item">
                    <a class="nav-link rentapp-nav-link @(currentController == "Home" && currentAction == "Index" && currentPath == "/" ? "active" : "")" 
                       asp-controller="Home" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon me-1">
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        <span>Home</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rentapp-nav-link @(currentPath.Contains("NearYou", StringComparison.OrdinalIgnoreCase) ? "active" : "")" 
                       asp-controller="Home" asp-action="NearYou">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon me-1">
                            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        <span>Near You</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rentapp-nav-link @(currentPath.Contains("Rooms", StringComparison.OrdinalIgnoreCase) ? "active" : "")" 
                       asp-controller="Home" asp-action="Rooms">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon me-1">
                            <path d="M2 4v16"/>
                            <path d="M2 8h18a2 2 0 0 1 2 2v10"/>
                            <path d="M2 17h20"/>
                            <path d="M6 8v9"/>
                        </svg>
                        <span>Rooms</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link rentapp-nav-link @(currentPath.Contains("Shops", StringComparison.OrdinalIgnoreCase) ? "active" : "")" 
                       asp-controller="Home" asp-action="Shops">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-icon me-1">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                            <path d="M3 6h18"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                        <span>Shops</span>
                    </a>
                </li>
            </ul>

            <!-- Circular Profile Button & Dropdown -->
            <div class="d-flex align-items-center">
                <div class="dropdown rentapp-profile-dropdown">
                    <button class="btn p-0 border-0 bg-transparent rentapp-profile-btn" 
                            type="button" 
                            id="profileDropdownMenu" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false"
                            title="Profile">
                        <div class="rentapp-avatar-circle">
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <img src="@Model.ProfilePictureUrl" alt="Profile" class="rentapp-avatar-img" />
                            }
                            else if (!string.IsNullOrEmpty(Model.Initials))
                            {
                                <span class="rentapp-avatar-initials">@Model.Initials</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rentapp-avatar-icon">
                                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            }
                            @if (Model.IsAuthenticated)
                            {
                                <span class="rentapp-status-badge" title="Online"></span>
                            }
                        </div>
                    </button>

                    <!-- Profile Dropdown Menu -->
                    <ul class="dropdown-menu dropdown-menu-end rentapp-dropdown-menu shadow-lg border-0" aria-labelledby="profileDropdownMenu">
                        @if (Model.IsAuthenticated)
                        {
                            <!-- Authenticated Header -->
                            <li class="dropdown-header px-3 py-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rentapp-avatar-circle rentapp-avatar-circle-sm">
                                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                        {
                                            <img src="@Model.ProfilePictureUrl" alt="Profile" class="rentapp-avatar-img" />
                                        }
                                        else
                                        {
                                            <span class="rentapp-avatar-initials">@Model.Initials</span>
                                        }
                                    </div>
                                    <div class="rentapp-user-info overflow-hidden">
                                        <div class="fw-bold text-dark text-truncate">@(Model.FullName ?? "My Account")</div>
                                        @if (!string.IsNullOrEmpty(Model.Email))
                                        {
                                            <div class="text-muted small text-truncate">@Model.Email</div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.Role))
                                        {
                                            <span class="badge bg-primary-subtle text-primary mt-1">@Model.Role</span>
                                        }
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-2"></li>
                            <!-- View profile -->
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Account" asp-action="Profile">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary">
                                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    <span>View profile</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-2"></li>
                            <!-- Logout -->
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger rentapp-logout-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                            <polyline points="16 17 21 12 16 7"/>
                                            <line x1="21" y1="12" x2="9" y2="12"/>
                                        </svg>
                                        <span>Logout</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- Guest / Unauthenticated State -->
                            <li class="dropdown-header px-3 py-2">
                                <div class="fw-bold text-dark">Welcome Guest</div>
                                <div class="text-muted small">Sign in to manage your rentals</div>
                            </li>
                            <li><hr class="dropdown-divider my-2"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Account" asp-action="Profile">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary">
                                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    <span>View profile</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-primary fw-semibold" asp-controller="Auth" asp-action="Login">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                                        <polyline points="10 17 15 12 10 7"/>
                                        <line x1="15" y1="12" x2="3" y2="12"/>
                                    </svg>
                                    <span>Sign In</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Auth" asp-action="Register">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <line x1="19" y1="8" x2="19" y2="14"/>
                                        <line x1="22" y1="11" x2="16" y2="11"/>
                                    </svg>
                                    <span>Register</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-2"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-muted" asp-controller="Auth" asp-action="Login">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                        <polyline points="16 17 21 12 16 7"/>
                                        <line x1="21" y1="12" x2="9" y2="12"/>
                                    </svg>
                                    <span>Logout</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>
